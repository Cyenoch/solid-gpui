+    #[test]
+    fn changing_line_clamp_relayouts_within_and_across_frames() {
+        let cache = LineLayoutCache::new(
+            Arc::new(crate::NoopTextSystem),
+            Arc::new(AtomicUsize::new(0)),
+        );
+        let text = "one two three four five six seven eight";
+        let runs = [FontRun {
+            len: text.len(),
+            font_id: FontId(0),
+        }];
+        let shape = |limit| cache.layout_wrapped_line(text, px(16.), &runs, Some(px(45.)), limit);
+        let one = shape(Some(1));
+        let three = shape(Some(3));
+        let all = shape(None);
+        assert_eq!(one.wrap_boundaries.len(), 0);
+        assert_eq!(three.wrap_boundaries.len(), 2);
+        assert!(all.wrap_boundaries.len() > 2);
+        assert!(Arc::ptr_eq(&three, &shape(Some(3))));
+        cache.finish_frame();
+        assert!(Arc::ptr_eq(&one, &shape(Some(1))));
+        assert!(Arc::ptr_eq(&all, &shape(None)));
+        assert_eq!(shape(Some(2)).wrap_boundaries.len(), 1);
+    }
 
