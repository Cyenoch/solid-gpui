+/// Run one module on a caller-owned runtime thread without entering CLI
+/// dispatch or terminating the host process.
+///
+/// # Safety
+///
+/// `entry` must point to `len` readable bytes for the duration of the call.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn bun_embedded_eval(
+    entry: *const u8,
+    len: usize,
+) -> c_int {
+    if entry.is_null() || len == 0 {
+        return 2;
+    }
+
+    // SAFETY: the caller owns the byte range for the duration of this call.
+    let entry = unsafe { core::slice::from_raw_parts(entry, len) };
+    // These process-level hooks are normally installed by `main`; the
+    // embedding entry performs the same initialization on its dedicated
+    // thread, without changing the host's process lifetime.
+    unsafe { bun_core::init_argv(0, ptr::null()) };
+    bun_crash_handler::init();
+    use_mimalloc_in_dependencies();
+    output::stdio::init();
+    StackCheck::configure_thread();
+    bun_io::ParentDeathWatchdog::install();
+
+    match bun_runtime::embedded::eval_entry_point(entry) {
+        Ok(code) => code as c_int,
+        Err(error) => {
+            eprintln!("bun embedded eval failed: {error}");
+            1
+        }
+    }
+}
+
+/// Run one module with a host-owned bounded byte callback bridge.
+///
+/// # Safety
+///
+/// `entry` is readable for `len` bytes and `io` points to a callback table
+/// that remains alive until this call returns. Callback implementations must
+/// not unwind through this ABI.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn bun_embedded_eval_with_io(
+    entry: *const u8,
+    len: usize,
+    io: *const bun_runtime::embedded::EmbeddedIoCallbacks,
+) -> c_int {
+    if entry.is_null() || len == 0 || io.is_null() {
+        return 2;
+    }
+
+    // SAFETY: validated above; the caller owns both ranges for this call.
+    let entry = unsafe { core::slice::from_raw_parts(entry, len) };
+    let io = unsafe { &*io };
+    unsafe { bun_core::init_argv(0, ptr::null()) };
+    bun_crash_handler::init();
+    use_mimalloc_in_dependencies();
+    output::stdio::init();
+    StackCheck::configure_thread();
+    bun_io::ParentDeathWatchdog::install();
+
+    match bun_runtime::embedded::eval_entry_point_with_io(entry, io) {
+        Ok(code) => code as c_int,
+        Err(error) => {
+            eprintln!("bun embedded eval failed: {error}");
+            1
+        }
+    }
+}
