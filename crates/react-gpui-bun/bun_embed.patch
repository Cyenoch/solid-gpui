+//! Embedding entrypoint for hosts that keep Bun on a dedicated thread.
+//!
+//! This path deliberately bypasses `Cli::start`: CLI dispatch is process
+//! oriented and many command branches terminate through `Global::exit`.
+//! Embedding starts the real JSC VM directly, loads one module, drives Bun's
+//! event loop, and tears down that VM before returning to the caller.
+
+use std::cell::{Cell, RefCell};
+use std::ffi::c_void;
+
+use bun_jsc::js_function::CreateJSFunctionOptions;
+use bun_jsc::virtual_machine::{InitOptions, VirtualMachine};
+use bun_jsc::{CallFrame, JSFunction, JSGlobalObject, JSValue, JsResult};
+
+/// Host-owned byte transport callbacks. Both callbacks run synchronously on
+/// the Bun/JSC thread; they must not touch GPUI or enter JavaScript.
+#[repr(C)]
+pub struct EmbeddedIoCallbacks {
+    pub context: *mut c_void,
+    pub write_commit: unsafe extern "C" fn(*mut c_void, *const u8, usize) -> bool,
+    /// Returns zero when no event is ready, `usize::MAX` when the input is
+    /// closed, or the number of bytes copied into `out`.
+    pub read_event: unsafe extern "C" fn(*mut c_void, *mut u8, usize) -> usize,
+    /// Returns zero when no source reload is ready, `usize::MAX` when closed,
+    /// or the number of UTF-8 path bytes copied into `out`.
+    pub read_refresh: unsafe extern "C" fn(*mut c_void, *mut u8, usize) -> usize,
+}
+thread_local! {
+    static IO_CALLBACKS: Cell<*const EmbeddedIoCallbacks> = const { Cell::new(core::ptr::null()) };
+}
+
+thread_local! {
+    static EVENT_BUFFER: RefCell<Vec<u8>> = RefCell::new(vec![0; 16 * 1024 * 1024]);
+}
+
+fn callbacks() -> Option<&'static EmbeddedIoCallbacks> {
+    IO_CALLBACKS.with(|slot| {
+        let ptr = slot.get();
+        if ptr.is_null() {
+            None
+        } else {
+            // SAFETY: the caller keeps the callback table alive for the whole
+            // `eval_entry_point_with_io` call on this same thread.
+            Some(unsafe { &*ptr })
+        }
+    })
+}
+
+#[bun_jsc::host_fn]
+fn react_gpui_write(global: &JSGlobalObject, frame: &CallFrame) -> JsResult<JSValue> {
+    let args = frame.arguments();
+    let Some(value) = args.first().copied() else {
+        return Err(global.throw_invalid_arguments(format_args!(
+            "react_gpui_write requires a Uint8Array"
+        )));
+    };
+    let Some(buffer) = value.as_array_buffer(global) else {
+        return Err(global.throw_invalid_arguments(format_args!(
+            "react_gpui_write requires a Uint8Array"
+        )));
+    };
+    let Some(io) = callbacks() else {
+        return Err(global.throw(format_args!("embedded Bun transport is shut down")));
+    };
+    let bytes = buffer.byte_slice();
+    // SAFETY: callback table and byte slice are valid for this synchronous call.
+    let accepted = unsafe { (io.write_commit)(io.context, bytes.as_ptr(), bytes.len()) };
+    if accepted {
+        Ok(JSValue::js_boolean(true))
+    } else {
+        Err(global.throw(format_args!("embedded Bun commit queue is closed")))
+    }
+}
+
+#[bun_jsc::host_fn]
+fn react_gpui_read(global: &JSGlobalObject, _frame: &CallFrame) -> JsResult<JSValue> {
+    let Some(io) = callbacks() else {
+        return Ok(JSValue::FALSE);
+    };
+    let (ptr, cap) = EVENT_BUFFER.with(|buffer| {
+        let mut buffer = buffer.borrow_mut();
+        (buffer.as_mut_ptr(), buffer.len())
+    });
+    // SAFETY: callback table is valid and `ptr` addresses the reusable
+    // thread-local buffer for this synchronous call.
+    let length = unsafe { (io.read_event)(io.context, ptr, cap) };
+    if length == 0 {
+        return Ok(JSValue::NULL);
+    }
+    if length == usize::MAX {
+        return Ok(JSValue::FALSE);
+    }
+    if length > cap {
+        return Err(global.throw(format_args!(
+            "embedded Bun event callback exceeded frame limit"
+        )));
+    }
+    let bytes = EVENT_BUFFER.with(|buffer| buffer.borrow()[..length].to_vec());
+    JSValue::create_buffer_from_box(global, bytes.into_boxed_slice())
+}
+
+#[bun_jsc::host_fn]
+fn react_gpui_read_refresh(
+    global: &JSGlobalObject,
+    _frame: &CallFrame,
+) -> JsResult<JSValue> {
+    let Some(io) = callbacks() else {
+        return Ok(JSValue::FALSE);
+    };
+    let (ptr, cap) = EVENT_BUFFER.with(|buffer| {
+        let mut buffer = buffer.borrow_mut();
+        (buffer.as_mut_ptr(), buffer.len())
+    });
+    // SAFETY: callback table is valid and `ptr` addresses the reusable
+    // thread-local buffer for this synchronous call.
+    let length = unsafe { (io.read_refresh)(io.context, ptr, cap) };
+    if length == 0 {
+        return Ok(JSValue::NULL);
+    }
+    if length == usize::MAX {
+        return Ok(JSValue::FALSE);
+    }
+    if length > cap {
+        return Err(global.throw(format_args!(
+            "embedded Bun refresh callback exceeded frame limit"
+        )));
+    }
+    let bytes = EVENT_BUFFER.with(|buffer| buffer.borrow()[..length].to_vec());
+    JSValue::create_buffer_from_box(global, bytes.into_boxed_slice())
+}
+
+fn install_io_globals(vm: &VirtualMachine) {
+    let global = vm.global();
+    let target = global.to_js_value();
+    target.put(
+        global,
+        "__react_gpui_write",
+        JSFunction::create(
+            global,
+            bun_core::String::static_(b"__react_gpui_write"),
+            __jsc_host_react_gpui_write,
+            1,
+            CreateJSFunctionOptions::default(),
+        ),
+    );
+    target.put(
+        global,
+        "__react_gpui_read",
+        JSFunction::create(
+            global,
+            bun_core::String::static_(b"__react_gpui_read"),
+            __jsc_host_react_gpui_read,
+            0,
+            CreateJSFunctionOptions::default(),
+        ),
+    );
+    target.put(
+        global,
+        "__react_gpui_read_refresh",
+        JSFunction::create(
+            global,
+            bun_core::String::static_(b"__react_gpui_read_refresh"),
+            __jsc_host_react_gpui_read_refresh,
+            0,
+            CreateJSFunctionOptions::default(),
+        ),
+    );
+}
+
+fn quote_module_path(path: &[u8]) -> String {
+    let path = String::from_utf8_lossy(path);
+    path.replace('\\', "\\\\")
+        .replace('"', "\\\"")
+        .replace('\n', "\\n")
+        .replace('\r', "\\r")
+}
+
+fn callback_wrapper(entry_path: &[u8]) -> Box<[u8]> {
+    let entry = quote_module_path(entry_path);
+    format!(
+        "const __rgpListeners = [];\n\
+         const __rgpInput = {{ on(kind, fn) {{ if (kind === 'data') __rgpListeners.push(fn); return this; }},\n\
+         off(kind, fn) {{ if (kind === 'data') {{ const i = __rgpListeners.indexOf(fn); if (i >= 0) __rgpListeners.splice(i, 1); }} }},\n\
+         removeListener(kind, fn) {{ this.off(kind, fn); }} }};\n\
+         const __rgpOutput = {{ write(frame) {{ return globalThis.__react_gpui_write(frame); }},\n\
+         on() {{ return this; }} }};\n\
+         Object.defineProperty(process, 'stdin', {{ value: __rgpInput, configurable: true }});\n\
+         Object.defineProperty(process, 'stdout', {{ value: __rgpOutput, configurable: true }});\n\
+         let __rgpRefreshPending = false;\n\
+         const __rgpScheduleRefresh = () => {{\n\
+           if (__rgpRefreshPending) return;\n\
+           __rgpRefreshPending = true;\n\
+           queueMicrotask(() => {{\n\
+             __rgpRefreshPending = false;\n\
+             globalThis.RefreshRuntime?.performReactRefresh?.();\n\
+           }});\n\
+         }};\n\
+         const __rgpTimer = setInterval(() => {{\n\
+           const refresh = globalThis.__react_gpui_read_refresh();\n\
+           if (refresh === false) {{ clearInterval(__rgpTimer); return; }}\n\
+           if (refresh !== null) {{\n\
+             const path = new TextDecoder().decode(refresh);\n\
+             import(`${{path}}?react_gpui_refresh=${{Date.now()}}`).then(() => {{
+               __rgpScheduleRefresh();
+             }}).catch((error) => {{
+               console.error(`[react-gpui] Fast Refresh kept the last-good tree: ${{error}}`);
+             }});
+           }}\n\
+           const frame = globalThis.__react_gpui_read();\n\
+           if (frame === false) {{ clearInterval(__rgpTimer); return; }}\n\
+           if (frame !== null) for (const listener of __rgpListeners) listener(frame);\n\
+         }}, 0);\n\
+         await import(\"{entry}\");\n",
+        entry = entry,
+    )
+    .into_bytes()
+    .into_boxed_slice()
+}
+
+/// Evaluate one Bun module on the calling thread and return its exit code.
+pub fn eval_entry_point(entry_path: &[u8]) -> crate::Result<u8> {
+    eval_entry_point_inner(entry_path, None)
+}
+
+/// Evaluate one module with the callback bridge installed for the JS transport
+/// wrapper. The callback table is borrowed only for this synchronous call.
+pub fn eval_entry_point_with_io(
+    entry_path: &[u8],
+    io: &EmbeddedIoCallbacks,
+) -> crate::Result<u8> {
+    eval_entry_point_inner(entry_path, Some(io))
+}
+
+fn eval_entry_point_inner(
+    entry_path: &[u8],
+    io: Option<&EmbeddedIoCallbacks>,
+) -> crate::Result<u8> {
+    bun_jsc::initialize(false);
+    bun_ast::initialize_store();
+
+    let vm_ptr = VirtualMachine::init(InitOptions {
+        is_main_thread: true,
+        ..Default::default()
+    })?;
+    // SAFETY: `init` returns the unique VM allocated for this thread.
+    let vm = unsafe { &mut *vm_ptr };
+    vm.is_main_thread = true;
+    bun_jsc::virtual_machine::IS_MAIN_THREAD_VM.set(true);
+    let api_lock = vm.global().vm().get_api_lock();
+    if io.is_some() {
+        install_io_globals(vm);
+        IO_CALLBACKS.with(|slot| slot.set(io.map_or(core::ptr::null(), core::ptr::from_ref)));
+    }
+
+    let mut entry_owner = entry_path.to_vec().into_boxed_slice();
+    let mut wrapper_owner = io.map(|_| callback_wrapper(entry_path));
+    let run_entry = if let Some(wrapper) = wrapper_owner.as_mut() {
+        let path = b"/[eval]";
+        vm.module_loader.eval_source = Some(Box::new(bun_ast::Source::init_path_string(
+            path,
+            &wrapper[..],
+        )));
+        path.as_slice()
+    } else {
+        entry_owner.as_mut()
+    };
+    vm.set_main(run_entry);
+    vm.load_extra_env_and_source_code_printer();
+
+    let eval_result = vm.load_entry_point(run_entry).map(|_| ());
+    if eval_result.is_ok() {
+        while vm.is_event_loop_alive() {
+            vm.tick();
+            vm.auto_tick_active();
+        }
+    }
+    vm.on_before_exit();
+    vm.on_exit();
+    let code = vm.exit_handler.exit_code;
+
+    // Teardown must run while the API lock is held. The lock's Drop would
+    // dereference the destroyed JSC VM, so consume the guard after teardown.
+    unsafe { VirtualMachine::teardown_embedded(vm_ptr) };
+    core::mem::forget(api_lock);
+    IO_CALLBACKS.with(|slot| slot.set(core::ptr::null()));
+    drop(wrapper_owner);
+    drop(entry_owner);
+    eval_result?;
+    Ok(code)
+}
