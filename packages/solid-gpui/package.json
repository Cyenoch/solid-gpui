{
  "name": "@solid-gpui/core",
  "version": "0.2.0",
  "description": "SolidJS renderer for native GPUI surfaces.",
  "keywords": [
    "solidjs",
    "gpui",
    "native-ui",
    "bun"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cyenoch/solid-gpui.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "src/vite"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js",
      "default": "./dist/stdio.js"
    },
    "./embedded": {
      "types": "./dist/embedded.d.ts",
      "import": "./dist/embedded.js",
      "default": "./dist/embedded.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts"
    },
    "./vite": "./src/vite/index.ts",
    "./vite/dev": "./src/vite/dev.ts",
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "default": "./dist/native.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js",
      "default": "./dist/components.js"
    },
    "./vite/build": "./src/vite/build.ts"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "@jridgewell/remapping": "2.3.5",
    "@solidjs/compiler": "2.0.0-rc.6",
    "bebop": "3.2.3",
    "core-js-pure": "3.50.0",
    "event-target-shim": "6.0.2",
    "oxc-transform": "0.148.0",
    "oxfmt": "0.66.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.10",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@solid-gpui/router": "workspace:*"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "bin": {
    "solid-gpui-dev": "./src/vite/dev.ts",
    "solid-gpui-build": "./src/vite/build.ts"
  }
}
