{
  "name": "@react-gpui/core",
  "version": "0.1.0",
  "description": "React custom renderer for the native GPUI host.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun run build:js && bun run build:types",
    "build:js": "bun build ./src/index.ts --outdir ./dist --target bun --format esm --external react --external react-reconciler --external @msgpack/msgpack",
    "build:types": "bunx tsc --project tsconfig.build.json",
    "format": "prettier --check \"src/**/*.{ts,tsx,js,json}\" \"tests/**/*.{ts,tsx,js,json}\" \"examples/**/*.{ts,tsx,js,json}\" \"*.json\"",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "example:counter": "bun run examples/counter.tsx",
    "pack:dry-run": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "react-reconciler": "0.33.0"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "bun-types": "1.1.29",
    "prettier": "3.6.2",
    "react": "19.2.8",
    "typescript": "5.9.3"
  }
}
