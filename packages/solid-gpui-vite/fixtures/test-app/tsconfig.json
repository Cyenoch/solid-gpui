{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solid-gpui/core",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun-types", "vite/client"],
    "customConditions": ["solid-gpui-source"],
    "paths": {
      "#native": ["./generated/native.ts"]
    }
  },
  "include": ["src", "generated", "counter.test.tsx", "vite.config.ts"]
}
