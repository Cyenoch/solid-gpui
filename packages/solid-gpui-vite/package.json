{
  "name": "@solid-gpui/vite",
  "version": "0.3.0",
  "description": "Vite integration for Solid GPUI applications running in Bun or QuickJS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cyenoch/solid-gpui.git"
  },
  "type": "module",
  "bin": {
    "solid-gpui": "./dist/cli.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "solid-gpui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dev": {
      "solid-gpui-source": "./src/dev.ts",
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    },
    "./project": {
      "solid-gpui-source": "./src/project.ts",
      "types": "./dist/project.d.ts",
      "import": "./dist/project.js"
    },
    "./artifacts": {
      "solid-gpui-source": "./src/artifacts.ts",
      "types": "./dist/artifacts.d.ts",
      "import": "./dist/artifacts.js"
    },
    "./test": {
      "solid-gpui-source": "./src/test.ts",
      "types": "./dist/test.d.ts",
      "import": "./dist/test.js"
    },
    "./embedded": {
      "solid-gpui-source": "./src/embedded.ts",
      "types": "./dist/embedded.d.ts",
      "import": "./dist/embedded.js"
    },
    "./source": {
      "solid-gpui-source": "./src/source.ts",
      "types": "./dist/source.d.ts",
      "import": "./dist/source.js"
    },
    "./doctor": {
      "solid-gpui-source": "./src/doctor.ts",
      "types": "./dist/doctor.d.ts",
      "import": "./dist/doctor.js"
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "@jridgewell/remapping": "2.3.5",
    "@solidjs/compiler": "2.0.0-rc.9",
    "core-js-pure": "3.50.0",
    "event-target-shim": "6.0.2",
    "oxc-transform": "0.148.0",
    "oxfmt": "0.66.0",
    "@jridgewell/trace-mapping": "0.3.31"
  },
  "peerDependencies": {
    "@solid-gpui/core": "^0.3.0",
    "vite": "^8.2.2"
  },
  "peerDependenciesMeta": {
    "@solid-gpui/core": {
      "optional": true
    }
  }
}
