{
  "name": "@solid-gpui/shiki",
  "version": "0.4.1",
  "description": "Shiki syntax highlighting for native Solid GPUI code blocks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cyenoch/solid-gpui.git",
    "directory": "packages/solid-gpui-shiki"
  },
  "homepage": "https://cyenoch.github.io/solid-gpui/",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.js",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "solid-gpui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./bun": {
      "solid-gpui-source": "./src/bun.ts",
      "types": "./dist/bun.d.ts",
      "import": "./dist/bun.js",
      "default": "./dist/bun.js"
    },
    "./worker": {
      "solid-gpui-source": "./src/worker.ts",
      "default": "./dist/worker.js"
    }
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "dependencies": {
    "shiki": "4.4.2"
  },
  "peerDependencies": {
    "@solid-gpui/core": "^0.4.1",
    "solid-js": "^1.9.10"
  },
  "peerDependenciesMeta": {
    "@solid-gpui/core": {
      "optional": true
    }
  }
}
