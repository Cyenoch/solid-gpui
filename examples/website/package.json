{
  "name": "@solid-gpui/website",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:host && bun --bun vite --host 127.0.0.1",
    "build": "bun run build:host && bun run build:frontend",
    "build:host": "bun run build:bindings && bun run build:wasm",
    "build:wasm": "bash ../../scripts/build-web-wasm.sh",
    "build:bindings": "bun ../../scripts/native-codegen.ts --package solid-gpui --bin solid-gpui-host --features gpui-component --out packages/solid-gpui/src/components.ts",
    "build:frontend": "bun run typecheck && bun --bun vite build",
    "typecheck": "bun run routes:generate && tsc --noEmit",
    "dev:native": "bun ../../scripts/tasks.ts website-native-dev",
    "generate:native": "solid-gpui prepare --config vite.native.config.ts",
    "preview:native": "solid-gpui preview --config vite.native.config.ts",
    "build:native": "bun --bun vite build --config vite.native.config.ts",
    "build:embedded": "bun --bun vite build --config vite.embedded.config.ts",
    "test": "bun --conditions=browser test tests",
    "routes:generate": "bun generate-routes.ts"
  },
  "dependencies": {
    "@solid-gpui/core": "workspace:*",
    "@solid-gpui/shiki": "workspace:*",
    "assert": "2.1.0",
    "solid-js": "1.9.15",
    "@solid-gpui/router": "workspace:*"
  },
  "devDependencies": {
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "8.2.2",
    "@solid-gpui/vite": "workspace:*"
  }
}
