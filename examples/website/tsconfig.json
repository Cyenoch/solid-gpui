{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solid-gpui/core",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun-types", "vite/client"],
    "paths": {
      "@solid-gpui/shiki": ["../../packages/solid-gpui-shiki/src/index.ts"],
      "@solid-gpui/core": ["../../packages/solid-gpui/src/index.ts"],
      "@solid-gpui/core/runtime": ["../../packages/solid-gpui/src/runtime.ts"],
      "@solid-gpui/core/web": ["../../packages/solid-gpui/src/web.ts"],
      "@solid-gpui/core/*": ["../../packages/solid-gpui/src/*"],
      "@solid-gpui/router": ["../../packages/solid-gpui-router/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "tests/preview-audit.tsx"]
}
