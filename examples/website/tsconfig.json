{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solid-gpui/core",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun-types", "vite/client"],
    "customConditions": ["solid-gpui-source"]
  },
  "include": ["src", "vite.config.ts", "tests/preview-audit.tsx"]
}
