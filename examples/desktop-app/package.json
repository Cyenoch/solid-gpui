{
  "name": "@solid-gpui/desktop-app",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "solid-gpui prepare",
    "check:generated": "solid-gpui prepare --check",
    "doctor": "solid-gpui doctor",
    "typecheck": "tsc --noEmit",
    "test": "solid-gpui test",
    "dev": "bun --bun vite",
    "dev:rust": "cargo run -p desktop-app-host",
    "build": "bun run --bun vite build",
    "preview": "solid-gpui preview"
  },
  "dependencies": {
    "@solid-gpui/core": "workspace:*",
    "@solid-gpui/router": "workspace:*",
    "solid-js": "1.9.15"
  },
  "devDependencies": {
    "vite": "8.2.2",
    "@solid-gpui/vite": "workspace:*"
  }
}
