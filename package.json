{
  "name": "solid-gpui-workspace",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "task": "bun scripts/tasks.ts",
    "build": "bun run task build",
    "format": "bun run task format",
    "check": "bun run task check",
    "test": "bun run task test",
    "ci": "bun run task ci",
    "audit": "bun run task audit",
    "website": "bun run --cwd examples/website dev",
    "website:build": "bun run --cwd examples/website build",
    "website:native": "bun run task website-native",
    "website:native:dev": "bun run task website-native-dev",
    "website:native:package": "bun run task website-package",
    "quickjs:dev": "bun run task quickjs-dev"
  },
  "devDependencies": {
    "@jridgewell/remapping": "2.3.5",
    "@solidjs/compiler": "2.0.0-rc.6",
    "bebop-tools": "3.2.3",
    "bun-types": "1.4.2",
    "commander": "15.0.0",
    "oxc-transform": "0.148.0",
    "oxfmt": "0.66.0",
    "solid-js": "1.9.15",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "bebop-tools"
  ]
}
